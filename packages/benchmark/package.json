  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@swf/backend-dom": "0.0.0",
    "@swf/core": "0.0.0",
    "@swf/interaction": "0.0.0",
    "@swf/math": "0.0.0",
    "@swf/presentation": "0.0.0",
    "@swf/projections": "0.0.0",
    "@swf/surfaces": "0.0.0"
  }
}
