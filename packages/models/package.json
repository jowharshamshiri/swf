      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "program",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lungo-ts": "1.131.83"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
