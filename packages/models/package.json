{
  "name": "@swf/models",
  "version": "0.1.0",
  "description": "The Spatial Workspace Framework's state machines and decision logic, written and proved in Lean and run as WebAssembly: the program lungo generates from models/, loaded once.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
