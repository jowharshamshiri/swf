{
  "name": "@swf/interaction",
  "version": "0.1.0",
  "description": "Input and interaction for the Spatial Workspace Framework: device-neutral intents, spatial picking, input regions, a gesture arena with pointer capture, previewed drags committed once, explicit cancellation, and command equivalents for every spatial operation.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jowharshamshiri/swf.git",
    "directory": "packages/interaction"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@swf/core": "git+https://github.com/jowharshamshiri/swf.git#core/v0.1.0",
    "@swf/math": "git+https://github.com/jowharshamshiri/swf.git#math/v0.1.0",
    "@swf/models": "git+https://github.com/jowharshamshiri/swf.git#models/v0.1.0",
    "@swf/presentation": "git+https://github.com/jowharshamshiri/swf.git#presentation/v0.1.0",
    "@swf/projections": "git+https://github.com/jowharshamshiri/swf.git#projections/v0.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
