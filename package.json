{
  "version": "0.38.1141",
  "name": "swf",
  "private": true,
  "description": "Spatial Workspace Framework: a browser-first TypeScript framework for spatial presentation and window management.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/math",
    "packages/core",
    "packages/surfaces",
    "packages/presentation",
    "packages/projections",
    "packages/interaction",
    "packages/backend-dom",
    "packages/backend-geometry",
    "packages/conformance",
    "packages/diagnostics",
    "packages/persistence",
    "packages/benchmark",
    "apps/reference"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build -w @swf/reference",
    "build:packages": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "test:build": "vitest run --config vitest.build.config.mjs",
    "conformance": "node scripts/conformance.mjs",
    "bench": "node scripts/bench.mjs",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run build:packages && npm run typecheck && npm run lint && npm run test && npm run build",
    "dev": "npm run dev -w @swf/reference"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "5.1.0",
    "ajv": "8.17.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
