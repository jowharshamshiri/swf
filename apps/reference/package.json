{
  "name": "@swf/reference",
  "version": "0.0.0",
  "private": true,
  "description": "The Spatial Workspace Framework's reference application: a 360° panorama of seeded demo scenes, built only on the framework's public packages.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:everyday": "vite build --mode everyday",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p test/build/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@swf/backend-dom": "0.1.0",
    "@swf/backend-geometry": "0.1.0",
    "@swf/core": "0.1.0",
    "@swf/diagnostics": "0.1.0",
    "@swf/interaction": "0.1.0",
    "@swf/math": "0.1.0",
    "@swf/models": "0.1.0",
    "@swf/navigation": "0.1.0",
    "@swf/persistence": "0.1.0",
    "@swf/presentation": "0.1.0",
    "@swf/projections": "0.1.0",
    "@swf/surfaces": "0.1.0",
    "@wsb/uikit": "file:../../wsb/wsb/daemon/uikit",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/node": "24.19.2",
    "sass": "1.103.1",
    "svelte-check": "4.7.8",
    "vite": "8.3.8"
  }
}
